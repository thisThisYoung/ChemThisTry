{
  "name": "chemthistry",
  "version": "0.1.6",
  "description": "ChemThisTry - All-in-One Scientific Visualization Workstation",
  "main": "out/main/index.js",
  "author": "ChemThisTry Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/thisThisYoung/ChemThisTry",
  "repository": {
    "type": "git",
    "url": "https://github.com/thisThisYoung/ChemThisTry.git"
  },
  "scripts": {
    "fetch-pyodide": "node scripts/fetch-pyodide.mjs",
    "predev": "node scripts/fetch-pyodide.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev",
    "prebuild": "node scripts/fetch-pyodide.mjs",
    "build": "NODE_OPTIONS=\"--max-old-space-size=8192\" electron-vite build",
    "preview": "electron-vite preview",
    "dev:web": "NODE_OPTIONS=\"--max-old-space-size=8192\" vite --config vite.web.config.ts",
    "build:web": "NODE_OPTIONS=\"--max-old-space-size=8192\" vite build --config vite.web.config.ts",
    "gen:icon": "python3 scripts/gen-layered-icon.py",
    "cap:copy": "cap copy",
    "cap:sync": "cap sync",
    "cap:ios": "cap sync ios && cap open ios",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:plugins": "node scripts/actiontracker-smoke.mjs",
    "mcp": "node mcp/chemthistry-mcp.mjs",
    "mcp:test": "node mcp/smoke-test.mjs",
    "dist": "NODE_OPTIONS=\"--max-old-space-size=8192\" electron-vite build && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --config electron-builder.js",
    "dist:mac": "NODE_OPTIONS=\"--max-old-space-size=8192\" electron-vite build && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --config electron-builder.js --mac",
    "dist:win": "NODE_OPTIONS=\"--max-old-space-size=8192\" electron-vite build && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --config electron-builder.js --win",
    "dist:linux": "NODE_OPTIONS=\"--max-old-space-size=8192\" electron-vite build && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --config electron-builder.js --linux",
    "dist:dir": "NODE_OPTIONS=\"--max-old-space-size=8192\" electron-vite build && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --config electron-builder.js --dir"
  },
  "dependencies": {
    "3dmol": "^2.5.5",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "^6.3.1",
    "@lezer/markdown": "^1.7.2",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-heading": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-paragraph": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-task-item": "^2.27.3",
    "@tiptap/extension-task-list": "^2.27.3",
    "@tiptap/extension-text": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@xyflow/react": "^12.11.2",
    "ag-grid-community": "^32.3.3",
    "ag-grid-react": "^32.3.3",
    "better-sqlite3": "^11.8.1",
    "buffer": "^6.0.3",
    "codemirror-live-markdown": "0.5.1-alpha.1",
    "docx": "^9.8.1",
    "echarts": "^5.5.1",
    "echarts-gl": "^2.1.0",
    "electron-updater": "^6.3.4",
    "fabric": "^6.4.3",
    "fflate": "^0.8.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "katex": "^0.17.0",
    "ketcher-core": "3.15.0",
    "ketcher-react": "3.15.0",
    "ketcher-standalone": "3.15.0",
    "lucide-react": "^0.460.0",
    "mathjax-full": "^3.2.2",
    "mathml2omml": "^0.5.0",
    "mitt": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg2pdf.js": "^2.2.3",
    "temml": "^0.13.5",
    "tiptap-markdown": "^0.8.10",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@electron/rebuild": "^3.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.21"
  }
}
